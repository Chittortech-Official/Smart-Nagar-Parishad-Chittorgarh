# ──────────────────────────────────────────────────────────────
# SMART CHITTORGARH — Environment Variables
# Copy this file to .env.local and fill in your Supabase values
# ──────────────────────────────────────────────────────────────

# Supabase Project URL (from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous/Public Key (from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ──────────────────────────────────────────────────────────────
# NOTE: The platform runs in DEMO MODE without Supabase!
# All 6 roles work with mock data out of the box.
# Add Supabase credentials above only when ready for production.
# ──────────────────────────────────────────────────────────────
